# ENV TEMPLATE
# DO NOT COMMIT REAL VALUES
# This file serves as documentation for setting up the environment variables in Coolify.
# The actual filled-in .env file must never be committed. It lives either directly in Coolify's environment-variables UI, or in a local file outside the repo on the operator's machine.

# --- CRITICAL SECRETS (MUST BE REUSED FROM OLD DEPLOYMENT) ---
# These are required to decrypt existing data. Do NOT regenerate.
NEXTAUTH_SECRET=REUSE_OLD_VALUE
ENCRYPTION_KEY=REUSE_OLD_VALUE
CRON_SECRET=REUSE_OLD_VALUE

# --- DATABASE SECRETS ---
# Safe to regenerate.
POSTGRES_DB=formbricks
POSTGRES_USER=formbricks
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM

# --- MINIO / S3 SECRETS ---
# Safe to regenerate, but if regenerated, MinIO's own user/bucket policy must be updated to match on first boot.
S3_ACCESS_KEY=CHANGE_ME_GENERATE_RANDOM
S3_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM

# --- URLS AND DOMAINS (REUSE OLD VALUES) ---
NEXTAUTH_URL=https://form.evox.com.uy
WEBAPP_URL=https://form.evox.com.uy
S3_PUBLIC_URL=https://files.evox.com.uy
S3_BUCKET_NAME=formbricks
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1

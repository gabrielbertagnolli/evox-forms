# ENV TEMPLATE
# DO NOT COMMIT REAL VALUES
# This file serves as documentation for setting up the environment variables in Coolify.
# The actual filled-in .env file must never be committed. It lives either directly in Coolify's environment-variables UI, or in a local file outside the repo on the operator's machine.

# --- CRITICAL SECRETS (MUST BE REUSED FROM OLD DEPLOYMENT) ---
# These are required to decrypt existing data. Do NOT regenerate.
NEXTAUTH_SECRET=REUSE_OLD_VALUE
ENCRYPTION_KEY=REUSE_OLD_VALUE
CRON_SECRET=REUSE_OLD_VALUE

# --- DATABASE SECRETS ---
# Safe to regenerate.
POSTGRES_DB=formbricks
POSTGRES_USER=formbricks
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM

# --- MINIO / S3 SECRETS ---
# Only safe to regenerate if formbricks_minio_data starts as an EMPTY volume.
# CONFIRMED in Lane 4 rehearsal: if you attach the original (non-empty)
# formbricks_minio_data volume, these MUST match the original MinIO root
# credentials exactly — MinIO persists its root user inside the volume
# itself (.minio.sys) on first boot and ignores new env-provided credentials
# once that identity already exists. See docs/evox/MIGRATION_NOTES.md §3.
S3_ACCESS_KEY=REUSE_OLD_VALUE_IF_REUSING_ORIGINAL_VOLUME
S3_SECRET_KEY=REUSE_OLD_VALUE_IF_REUSING_ORIGINAL_VOLUME

# --- URLS AND DOMAINS (REUSE OLD VALUES) ---
NEXTAUTH_URL=https://form.evox.com.uy
WEBAPP_URL=https://form.evox.com.uy
S3_PUBLIC_URL=https://files.evox.com.uy
S3_BUCKET_NAME=formbricks
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1

# --- SMTP ---
SMTP_HOST=correo.evox.com.uy
SMTP_PORT=465
SMTP_USER=forms@evox.com.uy
SMTP_PASSWORD=CHANGE_ME_REAL_PASSWORD
SMTP_SECURE_ENABLED=1
MAIL_FROM=forms@evox.com.uy

# --- OTHER VARS ---
NODE_TLS_REJECT_UNAUTHORIZED=0
NEXT_IMAGE_EXPORT_LOADER=1
CUBEJS_API_SECRET=CHANGE_ME_GENERATE_RANDOM
CUBEJS_API_URL=http://formbricks-cube:4000
HUB_API_URL=http://localhost:3000
HUB_API_KEY=CHANGE_ME_GENERATE_RANDOM
